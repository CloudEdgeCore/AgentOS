{
  "apiVersion": "agentos.dev/v1",
  "kind": "AgentVersion",
  "metadata": { "name": "research-writer", "version": "1.0.0", "namespace": "default" },
  "spec": {
    "runtimeClassPolicy": { "allowed": ["research-reasoning"], "preferred": "research-reasoning" },
    "lifecycle": { "maxAttempts": 3 },
    "runtimes": [{ "class": "research-reasoning", "interface": "agentos.runtime.interface/v1", "runtimeABI": "agentos.adapter-http/v1", "entrypoint": ["agentos-binding://research"] }],
    "capabilities": {
      "tools": [],
      "models": ["__MODEL_REASONING__"],
      "memory": ["research/*"],
      "secrets": []
    },
    "budget": { "tokens": 30000, "costUsd": 4.50, "toolCalls": 8, "wallSeconds": 600 },
    "checkpoint": { "mode": "logical", "schemaVersion": "research/v1", "intervalSeconds": 30 }
  }
}
